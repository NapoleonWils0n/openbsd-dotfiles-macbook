default partial alphanumeric_keys 
xkb_symbols "alt_win_ctrl" {

    // mac swap alt_win_ctrl

    // include "macintosh_vndr/gb"

    name[Group1]= "alt_win_ctrl - Mac";

    key <LALT> { [ Super_L ] };
    key <LWIN> { [ Control_L, Control_L ] };
    key <LCTL> { [ Alt_L, Meta_L ] };
    key <AE03> { [ 3, numbersign, sterling ] };

    // Key under Escape: section (unshifted), plusminus (shifted)
    key <TLDE> { [ grave, asciitilde, plusminus ] };

    // Key next to Left Shift: grave (unshifted), asciitilde (shifted)
    key <LSGT> { [ section, plusminus ] };
};
